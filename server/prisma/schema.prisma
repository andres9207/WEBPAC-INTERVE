/// Bitácora de auditoría funcional (database/migrations/0013_create_audit_log.sql).
/// Solo escritura: se inserta desde common/services/audit.service.js, nunca se actualiza ni se borra.
model tbl_audit_log {
  aud_id           BigInt     @id @default(autoincrement())
  aud_operation_id String     @db.Char(36)
  aud_entity       String     @db.VarChar(50)
  aud_record_id    Int?
  aud_field        String?    @db.VarChar(100)
  aud_old_value    String?    @db.Text
  aud_new_value    String?    @db.Text
  aud_operation    String     @db.VarChar(30)
  use_id           Int?
  aud_ip           String?    @db.VarChar(45)
  aud_create_at    DateTime   @default(now()) @db.Timestamp(3)
  tbl_users        tbl_users? @relation(fields: [use_id], references: [use_id], onDelete: NoAction, onUpdate: NoAction, map: "tbl_audit_log_users")

  @@index([aud_entity, aud_record_id], map: "ix_audit_log_entity_record")
  @@index([aud_operation_id], map: "ix_audit_log_operation_id")
  @@index([use_id], map: "ix_audit_log_use_id")
  @@index([aud_create_at], map: "ix_audit_log_create_at")
}

model tbl_user_pages {
  upg_id    Int       @id @default(autoincrement())
  use_id    Int
  pag_id    Int
  tbl_pages tbl_pages @relation(fields: [pag_id], references: [pag_id], onDelete: NoAction, onUpdate: NoAction, map: "tbl_user_pages_pages")
  tbl_users tbl_users @relation(fields: [use_id], references: [use_id], onDelete: NoAction, onUpdate: NoAction, map: "tbl_user_pages_users")

  @@unique([use_id, pag_id], map: "uq_user_pages_use_pag")
  @@index([pag_id], map: "tbl_user_pages_pages")
}

enum tbl_documents_doc_type {
  USERS
  PROFILES
  PAGINAS
  PERMISOS
}

enum tbl_status_sta_scope {
  GENERAL
}
