  use_change_password     Int?                   @default(1) @db.SmallInt
  use_create_by           Int?
  use_create_at           DateTime?              @default(now()) @db.Timestamp(0)
  use_update_by           Int?
  use_update_at           DateTime?              @default(now()) @db.Timestamp(0)
  use_delete_by           Int?
  use_delete_at           DateTime?              @db.Timestamp(0)
  use_idempotency_key     String?                @unique(map: "uq_users_idempotency_key") @db.Char(36)
  use_idempotency_hash    String?                @db.Char(64)
  tbl_audit_log           tbl_audit_log[]
  documents_created       tbl_documents[]        @relation("DocumentCreatedBy")
  documents_deleted       tbl_documents[]        @relation("DocumentDeletedBy")
  documents_updated       tbl_documents[]        @relation("DocumentUpdatedBy")
  tbl_login_attempts      tbl_login_attempts?
  tbl_notifications       tbl_notifications[]
  tbl_password_resets     tbl_password_resets?   @relation("PasswordResetUser")
  password_resets_created tbl_password_resets[]  @relation("PasswordResetCreatedBy")
  password_resets_updated tbl_password_resets[]  @relation("PasswordResetUpdatedBy")
  profiles_created        tbl_profiles[]         @relation("ProfileCreatedBy")
  profiles_deleted        tbl_profiles[]         @relation("ProfileDeletedBy")
  profiles_updated        tbl_profiles[]         @relation("ProfileUpdatedBy")
  tbl_sessions            tbl_sessions?
  tbl_user_pages          tbl_user_pages[]
  tbl_user_permissions    tbl_user_permissions[]
  created_by_user         tbl_users?             @relation("UserCreatedBy", fields: [use_create_by], references: [use_id], onDelete: NoAction, onUpdate: NoAction, map: "tbl_users_create_by")
  users_created           tbl_users[]            @relation("UserCreatedBy")
  deleted_by_user         tbl_users?             @relation("UserDeletedBy", fields: [use_delete_by], references: [use_id], onDelete: NoAction, onUpdate: NoAction, map: "tbl_users_delete_by")
  users_deleted           tbl_users[]            @relation("UserDeletedBy")
  tbl_profiles            tbl_profiles?          @relation("UserProfile", fields: [pro_id], references: [pro_id], onDelete: NoAction, onUpdate: NoAction, map: "tbl_users_profiles")
  tbl_status              tbl_status?            @relation(fields: [sta_id], references: [sta_id], onDelete: NoAction, onUpdate: NoAction, map: "tbl_users_status")
  updated_by_user         tbl_users?             @relation("UserUpdatedBy", fields: [use_update_by], references: [use_id], onDelete: NoAction, onUpdate: NoAction, map: "tbl_users_update_by")
  users_updated           tbl_users[]            @relation("UserUpdatedBy")

  @@index([pro_id], map: "tbl_users_profiles")
  @@index([sta_id], map: "tbl_users_status")
  @@index([use_create_by], map: "tbl_users_create_by")
  @@index([use_update_by], map: "tbl_users_update_by")
  @@index([use_delete_by], map: "tbl_users_delete_by")
