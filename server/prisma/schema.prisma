  @@unique([wrk_id, prv_id], map: "uq_work_providers_work_provider")
  @@index([wkp_create_by], map: "tbl_work_providers_create_by")
  @@index([prv_id], map: "tbl_work_providers_provider")
  @@index([sta_id], map: "tbl_work_providers_status")
  @@index([wkp_update_by], map: "tbl_work_providers_update_by")
}
